// The program's version information, which its file's Properties show. Written by symbolengine_add_app.
#pragma code_page(65001)
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @APP_VERSION_COMMAS@
 PRODUCTVERSION @APP_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@APP_COMPANY@\0"
            VALUE "FileDescription", "@APP_NAME@\0"
            VALUE "FileVersion", "@APP_VERSION@\0"
            VALUE "InternalName", "@APP_NAME@\0"
            VALUE "LegalCopyright", "@APP_COPYRIGHT@\0"
            VALUE "OriginalFilename", "@APP_NAME@.exe\0"
            VALUE "ProductName", "@APP_NAME@\0"
            VALUE "ProductVersion", "@APP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
